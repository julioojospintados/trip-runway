# Copia questo file in .env (locale, mai committato) e compila con le tue chiavi reali.
# Non incollare mai chiavi reali in chat o in un PR.

# URL pubblico del sito: usato per canonical, Open Graph, robots.txt e sitemap.
# In locale può restare http://localhost:3000; in produzione va il dominio reale.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database (Supabase Postgres) — Settings > Database > Connection string
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Auth (Clerk) — clerk.com > la tua app > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Voli + deeplink affiliati — unico provider (Amadeus rimosso: self-service chiuso da Amadeus a luglio 2026)
TRAVELPAYOUTS_API_TOKEN=""
TRAVELPAYOUTS_MARKER=""

# Protegge l'endpoint del cronjob notturno (/api/cron/update-prices).
# Senza, chiunque potrebbe innescare il batch e bruciare la quota API.
# Genera una stringa casuale lunga e impostala anche nelle env di Vercel.
CRON_SECRET=""
